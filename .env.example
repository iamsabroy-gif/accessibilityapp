# Required
JWT_SECRET=change-me-to-a-long-random-string

# Optional (enables POST /api/v1/admin/verify)
ADMIN_PASSWORD=

# Optional tuning (defaults shown)
PORT=8080
SCAN_TIMEOUT_SECONDS=180
WCAG_LEVEL=AA
MAX_CONCURRENT_SCANS=3
ALLOW_PRIVATE_SCANS=false
ACTIVE_ENGINE=native
LANDING_PAGE_ENABLED=true
LEAD_CAPTURE_ENABLED=true
LEAD_NOTIFY_EMAIL=iamsabroy@gmail.com
LEAD_IP_SALT=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Scan engine tuning (defaults shown)
# SCAN_WORKER=on                 # "off" = start a new browser for every scan
# SCAN_WORKER_RECYCLE_AFTER=50   # restart the shared browser after this many scans
# REPORT_STORE_DIR=data/reports  # where recent scan results are kept (24h)

# Returning-user approval: users who registered in an earlier session must
# request access; the owner (LEAD_NOTIFY_EMAIL) gets an email to approve, and
# the user is emailed a limited-use access code. Needs SMTP_* to be set.
# ACCESS_APPROVAL_ENABLED=false
# ACCESS_DEFAULT_SCANS=20        # scans included in each approved code
# ACCESS_CODE_TTL_DAYS=30        # days a code stays valid (0 = no expiry)
# ACCESS_STORE_PATH=data/access.json
# PUBLIC_BASE_URL=https://accessscan.in   # used for links in the emails
